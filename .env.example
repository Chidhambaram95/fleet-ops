NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Digits only, with country code. Leave empty to let WhatsApp ask for a contact.
NEXT_PUBLIC_MANAGER_PHONE=
# Google AI Studio key for Gemini Flash receipt scanning. Server-side only.
GOOGLE_GENERATIVE_AI_API_KEY=
# Supabase service role key (Project Settings > API). Server-side only: used to
# make logins with a password and to set new passwords. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
